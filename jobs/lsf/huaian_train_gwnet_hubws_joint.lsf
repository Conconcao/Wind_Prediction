#!/bin/bash
#BSUB -J huaian_gwnet_hubws
#BSUB -q gpu
#BSUB -L /bin/bash
#BSUB -n 8
#BSUB -gpu "num=1"
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=32GB]"
#BSUB -W 10:00
#BSUB -o /home3/s502024280003/Wind_Prediction/logs/%J.huaian_gwnet_hubws.out
#BSUB -e /home3/s502024280003/Wind_Prediction/logs/%J.huaian_gwnet_hubws.err

set -eo pipefail

PROJECT_ROOT="/home3/s502024280003/Wind_Prediction"
STORE_DIR="$PROJECT_ROOT/15min-lead/wind/artifacts/server_runs/huaian_store_hubws_joint"
RUN_DIR="$PROJECT_ROOT/15min-lead/wind/artifacts/server_runs/huaian_gwnet_hubws_joint_run"
ENV_NAME="${ENV_NAME:-AIRU-WRF-torch}"
CONDA_ROOT="${CONDA_ROOT:-$HOME/miniconda3}"

mkdir -p "$PROJECT_ROOT/logs"
mkdir -p "$RUN_DIR"
cd "$PROJECT_ROOT"

if [ -f "$CONDA_ROOT/etc/profile.d/conda.sh" ]; then
  set +u
  . "$CONDA_ROOT/etc/profile.d/conda.sh"
  conda activate "$ENV_NAME"
  set -u
elif command -v conda >/dev/null 2>&1; then
  eval "$(conda shell.bash hook)"
  set +u
  conda activate "$ENV_NAME"
  set -u
elif [ -x "$CONDA_ROOT/envs/$ENV_NAME/bin/python" ]; then
  export PATH="$CONDA_ROOT/envs/$ENV_NAME/bin:$PATH"
elif [ -f ".venv/bin/activate" ]; then
  set +u
  source .venv/bin/activate
  set -u
fi

if ! command -v python >/dev/null 2>&1; then
  echo "python not found after environment activation (ENV_NAME=$ENV_NAME, CONDA_ROOT=$CONDA_ROOT)" >&2
  exit 127
fi

python --version

python 15min-lead/wind/scripts/train_gwnet_from_store.py \
  --store-dir "$STORE_DIR" \
  --support-mode distance_correlation \
  --epochs 30 \
  --batch-size 64 \
  --residual-channels 32 \
  --dilation-channels 32 \
  --skip-channels 128 \
  --end-channels 256 \
  --kernel-size 2 \
  --blocks 2 \
  --layers 2 \
  --graph-order 2 \
  --output-dir "$RUN_DIR"
