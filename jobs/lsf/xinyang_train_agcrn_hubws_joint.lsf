#!/bin/bash
#BSUB -J xinyang_agcrn_hubws
#BSUB -q gpu
#BSUB -n 8
#BSUB -gpu "num=1"
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=32GB]"
#BSUB -W 10:00
#BSUB -o /home3/s502024280003/Wind_Prediction/logs/%J.xinyang_agcrn_hubws.out
#BSUB -e /home3/s502024280003/Wind_Prediction/logs/%J.xinyang_agcrn_hubws.err

set -eo pipefail

PROJECT_ROOT="/home3/s502024280003/Wind_Prediction"
STORE_DIR="$PROJECT_ROOT/15min-lead/wind/artifacts/server_runs/xinyang_store_hubws_joint"
RUN_DIR="$PROJECT_ROOT/15min-lead/wind/artifacts/server_runs/agcrn_hubws_joint_run"
ENV_NAME="${ENV_NAME:-AIRU-WRF-torch}"

mkdir -p "$PROJECT_ROOT/logs"
mkdir -p "$RUN_DIR"
cd "$PROJECT_ROOT"

if command -v conda >/dev/null 2>&1; then
  eval "$(conda shell.bash hook)"
  set +u
  conda activate "$ENV_NAME"
  set -u
elif [ -f ".venv/bin/activate" ]; then
  set +u
  source .venv/bin/activate
  set -u
fi

python --version

python 15min-lead/wind/scripts/train_agcrn_from_store.py \
  --store-dir "$STORE_DIR" \
  --epochs 30 \
  --batch-size 64 \
  --hidden-dim 64 \
  --embed-dim 10 \
  --cheb-k 3 \
  --num-layers 2 \
  --output-dir "$RUN_DIR"
