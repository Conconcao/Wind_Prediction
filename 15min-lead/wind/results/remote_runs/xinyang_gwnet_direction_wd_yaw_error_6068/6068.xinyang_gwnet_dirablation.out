DYNAMIC_DIRECTIONAL_SUPPORT="${DYNAMIC_DIRECTIONAL_SUPPORT:-0}"
DIRECTION_SUPPORT_SOURCE="${DIRECTION_SUPPORT_SOURCE:-auto}"
DIRECTION_SUPPORT_SIGMA_DEG="${DIRECTION_SUPPORT_SIGMA_DEG:-35}"

mkdir -p "$PROJECT_ROOT/logs"
mkdir -p "$RUN_DIR"
cd "$PROJECT_ROOT"

if command -v conda >/dev/null 2>&1; then
  eval "$(conda shell.bash hook)"
  set +u
  conda activate "$ENV_NAME"
  set -u
elif [ -f ".venv/bin/activate" ]; then
  set +u
  source .venv/bin/activate
  set -u
fi

python --version

CMD=(
