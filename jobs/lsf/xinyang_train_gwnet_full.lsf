#!/bin/bash
#BSUB -J xinyang_gwnet_full
#BSUB -q gpu
#BSUB -n 8
#BSUB -gpu "num=1"
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=64GB]"
#BSUB -W 12:00
#BSUB -o /home3/s502024280003/Wind_Prediction/logs/%J.xinyang_gwnet_full.out
#BSUB -e /home3/s502024280003/Wind_Prediction/logs/%J.xinyang_gwnet_full.err

set -euo pipefail

PROJECT_ROOT="/home3/s502024280003/Wind_Prediction"
STORE_DIR="$PROJECT_ROOT/15min-lead/wind/artifacts/server_runs/xinyang_store_full"
RUN_DIR="$PROJECT_ROOT/15min-lead/wind/artifacts/server_runs/gwnet_full_run"
ENV_NAME="${ENV_NAME:-AIRU-WRF-torch}"

mkdir -p "$PROJECT_ROOT/logs"
mkdir -p "$RUN_DIR"
cd "$PROJECT_ROOT"

if command -v conda >/dev/null 2>&1; then
  eval "$(conda shell.bash hook)"
  conda activate "$ENV_NAME"
elif [ -f ".venv/bin/activate" ]; then
  source .venv/bin/activate
fi

python --version

python 15min-lead/wind/scripts/train_gwnet_from_store.py \
  --store-dir "$STORE_DIR" \
  --support-mode distance_correlation \
  --epochs 30 \
  --batch-size 64 \
  --residual-channels 32 \
  --dilation-channels 32 \
  --skip-channels 128 \
  --end-channels 256 \
  --kernel-size 2 \
  --blocks 2 \
  --layers 2 \
  --graph-order 2 \
  --output-dir "$RUN_DIR"
